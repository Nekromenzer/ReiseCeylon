# Copy to .env.local and fill in. Find the project id at https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Same values again, for the Sanity CLI build of the hosted studio (sanity deploy).
# Vite only inlines SANITY_STUDIO_* — keep these in sync with the three above.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2024-10-01

# Any random string. Paste the same value into the Sanity webhook secret field.
SANITY_REVALIDATE_SECRET=

# Weekly blog-draft automation. Keep both secrets server-side and in GitHub
# Actions secrets; never prefix them with NEXT_PUBLIC_.
SANITY_API_TOKEN=
OPENAI_API_KEY=
# Optional. The scripts default to gpt-5-mini.
BLOG_AI_MODEL=gpt-5-mini

# Emailing finished journeys from /journeys. Get the key at resend.com/api-keys.
# RESEND_API_KEY is read first; RESEND_API is accepted as well.
RESEND_API_KEY=

# Where enquiries land. Defaults to the contact email in the studio.
JOURNEY_ENQUIRY_TO=

# The sender. Resend only accepts a domain you have verified with them; until
# one is, leave this as onboarding@resend.dev — which delivers only to the
# address that owns the Resend account.
JOURNEY_ENQUIRY_FROM=ReiseCeylon <onboarding@resend.dev>
