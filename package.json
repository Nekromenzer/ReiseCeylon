{
  "name": "reise-ceylon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "sanity": "sanity",
    "blog:generate-draft": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/generate-blog-draft.mjs",
    "blog:publish-approved": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/publish-approved-posts.mjs",
    "blog:normalize-links": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/normalize-blog-links.mjs",
    "blog:validate-topics": "node scripts/validate-blog-topics.mjs",
    "seed:journal": "node --env-file=.env scripts/seed-journal.mjs",
    "seed:site": "node --experimental-strip-types --env-file=.env scripts/seed-site.mjs",
    "sync:destinations": "node --env-file=.env scripts/sync-destinations.mjs",
    "sync:destinations:auth": "sanity exec scripts/sync-destinations.mjs --with-user-token --",
    "generate:destination-editorial": "sanity exec scripts/generate-destination-editorial.mjs --with-user-token",
    "migrate:locales": "node --env-file=.env scripts/migrate-locale-fields.mjs",
    "audit:destinations": "node scripts/audit-destination-content.mjs",
    "images:destinations": "node scripts/generate-destination-images.mjs",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs src/lib/*.test.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@next/third-parties": "^16.3.0",
    "@portabletext/react": "^7.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.9.1",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.23.12",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.25",
    "next": "^16.2.12",
    "next-intl": "^4.13.6",
    "next-sanity": "^13.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "resend": "^6.18.1",
    "sanity": "^6.9.1",
    "styled-components": "^6.5.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.17.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
